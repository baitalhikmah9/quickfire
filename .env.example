# Copy this file to `.env` (and optionally `.env.local` / `.env.production`) and fill in values.
# Variables prefixed with `EXPO_PUBLIC_` are bundled into the client app.
# Never commit real `.env`, `.env.local`, or `.env.production` files — they are gitignored.

# ---------------------------------------------------------------------------
# Client (required for app boot)
# ---------------------------------------------------------------------------

# Clerk publishable key (https://dashboard.clerk.com)
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...

# Convex deployment URL (https://dashboard.convex.dev)
EXPO_PUBLIC_CONVEX_URL=https://your-deployment.convex.cloud

# ---------------------------------------------------------------------------
# Client (optional)
# ---------------------------------------------------------------------------

# Canonical / Open Graph origin for web SEO. Defaults to https://playbackfire.com.
# EXPO_PUBLIC_SITE_ORIGIN=https://playbackfire.com

# Skip auth locally / on intentional preview deploys. Do not enable in production.
# EXPO_PUBLIC_DISABLE_AUTH=true

# Legacy API base URL (only if legacy client code is active).
# EXPO_PUBLIC_API_BASE_URL=

# ---------------------------------------------------------------------------
# RevenueCat — native IAP (https://app.revenuecat.com)
# ---------------------------------------------------------------------------

# Default for debug / local: Test Store (same public key for iOS + Android).
EXPO_PUBLIC_REVENUECAT_IOS_API_KEY=test_...
EXPO_PUBLIC_REVENUECAT_ANDROID_API_KEY=test_...

# Production store binaries only (local Gradle Android / local iOS release):
# set USE_PRODUCTION_STORE=1 and replace keys with appl_ / goog_ public SDK keys.
# See `.env.production` on the build machine (gitignored).
# EXPO_PUBLIC_REVENUECAT_USE_PRODUCTION_STORE=1
# EXPO_PUBLIC_REVENUECAT_IOS_API_KEY=appl_...
# EXPO_PUBLIC_REVENUECAT_ANDROID_API_KEY=goog_...

# Force Test Store even when production keys are present (standalone debug, etc.).
# EXPO_PUBLIC_REVENUECAT_USE_TEST_STORE=1

# ---------------------------------------------------------------------------
# RevenueCat — web billing / Stripe gateway
# ---------------------------------------------------------------------------

# Public SDK key for RC Web Billing. Env only; never commit real values.
# In Vercel, mark Sensitive. Use rcb_sb_... for Preview, rcb_... for Production.
# EXPO_PUBLIC_REVENUECAT_WEB_API_KEY=rcb_sb_...

# ---------------------------------------------------------------------------
# Convex CLI (local machine only; not read by the app bundle)
# ---------------------------------------------------------------------------

# Written by `bunx convex dev` / `convex login`. Points the CLI at a deployment.
# Prefer an explicit `--deployment-name` when scripting so prod is never accidental.
# CONVEX_DEPLOYMENT=dev:your-dev-deployment

# Not currently read by the app (HTTP actions site URL if needed later).
# EXPO_PUBLIC_CONVEX_SITE_URL=https://your-deployment.convex.site

# ---------------------------------------------------------------------------
# Convex dashboard environment (set in https://dashboard.convex.dev — not in .env)
# ---------------------------------------------------------------------------

# Clerk Frontend API URL used by convex/auth.config.ts
# CLERK_JWT_ISSUER_DOMAIN=https://your-app.clerk.accounts.dev
# Production example: https://clerk.playbackfire.com

# Clerk secret key for server-side account deletion (never EXPO_PUBLIC_)
# CLERK_SECRET_KEY=sk_test_...

# RevenueCat webhook Authorization header (must match the RC dashboard webhook)
# REVENUECAT_WEBHOOK_AUTH_HEADER=shared_secret_here

# RevenueCat API v2 — admin discount-code provisioning
# Needs project_configuration:discounts:read_write on the secret key
# REVENUECAT_V2_SECRET_API_KEY=sk_v2_...
# REVENUECAT_PROJECT_ID=proj...
